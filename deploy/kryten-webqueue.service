[Unit]
Description=kryten-webqueue - CyTube Queue Management
After=network.target

[Service]
Type=simple
User=kryten
Group=kryten
WorkingDirectory=/home/kryten
Environment=WQ_CONFIG=/etc/kryten-webqueue/config.json
ExecStart=/home/kryten/.local/bin/kryten-webqueue
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
# ProtectHome must be off — executable and venv live in ~/.local/pipx
ProtectHome=false
ReadWritePaths=/var/lib/kryten-webqueue /home/kryten/.local /home/kryten/emote_backups
PrivateTmp=true

[Install]
WantedBy=multi-user.target
